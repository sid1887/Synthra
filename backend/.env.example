SYNTHRA_ENV=development
PORT=3000
LOG_LEVEL=debug

# AI Service
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_groq_api_key_here
AI_PROVIDER=groq
AI_MODEL=llama-3.2-11b-vision-preview
AI_VISION_MODEL=llama-3.2-11b-vision-preview
AI_DETECTION_STRICT=false
AI_ALLOW_MOCK_FALLBACK=true

# Image Processing
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=1600

# Performance
REQUEST_TIMEOUT_MS=30000
SOFT_TIMEOUT_MS=15000
RATE_LIMIT_PER_MIN=30
CACHE_TTL_SECONDS=3600

# Features
ENABLE_SIM=true
ENABLE_3D=false
ENABLE_AUTOMATION=false

# Storage
STORAGE_PATH=./storage
TEMP_UPLOAD_PATH=./temp
MAX_HISTORY_ITEMS=100
